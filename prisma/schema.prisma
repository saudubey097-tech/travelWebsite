// Southbound — role-workflow database schema.
//
// This replaces the earlier speculative schema (a NextAuth-adapter/Stripe/
// Tour-catalog design that was never migrated — no migrations existed in
// this repo). It maps directly onto the six tables specified for this
// phase, plus one small addition: `sessions`, required for secure
// server-side session handling. Table/column names are snake_case via
// @@map/@map so this matches conventional Postgres naming even though the
// Prisma models are PascalCase.
//
// Run `npx prisma migrate dev --name role_workflow` once DATABASE_URL
// points at the real Neon database, then `npx prisma generate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The Vercel/Neon integration supplies DATABASE_URL in every environment.
  url = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CUSTOMER
  COORDINATOR
  DRIVER
  ADMIN

  @@map("app_role")
}

enum ServiceType {
  DAY_TOUR
  TRANSFER
  HOURLY
  CUSTOM

  @@map("service_type")
}

enum VehicleClass {
  SEDAN  @map("sedan")
  VAN    @map("van")
  XL_VAN @map("xlVan")

  @@map("vehicle_class")
}

// The full lifecycle from the spec, plus terminal/exception states.
enum BookingStatus {
  SUBMITTED
  PENDING_ASSIGNMENT
  ACCEPTED
  IN_COMMUNICATION
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  DECLINED
  REASSIGNMENT_REQUIRED
  CANCELLED

  @@map("booking_status")
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
  REVOKED

  @@map("assignment_status")
}

enum MessageVisibility {
  CUSTOMER_VISIBLE
  INTERNAL

  @@map("message_visibility")
}

// ---------- Identity & sessions ----------

model AppUser {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  name         String
  phone        String?
  role         Role    @default(CUSTOMER)
  active       Boolean @default(true)

  // --- Account security state ---
  emailVerifiedAt   DateTime? @map("email_verified_at")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  passwordUpdatedAt DateTime  @default(now()) @map("password_updated_at")

  // --- Admin MFA (TOTP) ---
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecretCipher  String?   @map("mfa_secret_cipher") // AES-256-GCM ciphertext, see src/lib/auth/mfa.ts
  mfaEnabledAt     DateTime? @map("mfa_enabled_at")
  recoveryCodes    RecoveryCode[]

  // Driver-specific profile fields. Null for non-drivers.
  driverLicenseNo    String?       @map("driver_license_no")
  vehicleClass       VehicleClass? @map("vehicle_class")
  vehicleCapacity    Int?          @map("vehicle_capacity")
  vehicleDescription String?       @map("vehicle_description")
  driverAvailable    Boolean       @default(true) @map("driver_available")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  bookingsAsCustomer BookingRequest[]  @relation("CustomerBookings")
  bookingsCoordinated BookingRequest[] @relation("CoordinatedBookings")
  assignments        BookingAssignment[] @relation("DriverAssignments")
  assignmentsOffered  BookingAssignment[] @relation("OfferedByCoordinator")
  messagesSent       BookingMessage[]
  events             BookingEvent[]
  notifications      Notification[]
  auditLogsAsActor   AuditLog[]        @relation("AuditActor")
  auditLogsAsTarget  AuditLog[]        @relation("AuditTarget")
  securityEventsAsUser   SecurityEvent[]        @relation("SecurityEventUser")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  invitationsSent         StaffInvitationToken[] @relation("InvitedBy")

  @@map("app_users")
  @@index([role])
  @@index([email])
}

// One-time TOTP recovery codes. Each row is a single code, hashed — never
// store recovery codes in plaintext. A row is deleted once used so a code
// can never be replayed.
model RecoveryCode {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  codeHash String  @map("code_hash")
  usedAt   DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recovery_codes")
  @@index([userId])
}

// A signed-in device/browser. Extended beyond the original minimal auth
// session so a user can see and manage where they're signed in
// ("session list", "revoke individual session", "logout all devices").
model Session {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  lastActiveAt  DateTime  @default(now()) @map("last_active_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

// Single-use, expiring token for verifying a customer's email address.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
  @@index([userId])
}

// Single-use, expiring token for the forgot-password flow.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([userId])
}

// An Admin-issued invitation to become staff (Coordinator or Driver). No
// AppUser row exists until the invitee accepts and sets their own password,
// so an expired unused invite never leaves an orphan account behind.
model StaffInvitationToken {
  id            String    @id @default(cuid())
  email         String
  name          String
  role          Role
  invitedById   String    @map("invited_by_id")
  tokenHash     String    @unique @map("token_hash")
  driverProfile Json?     @map("driver_profile")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  invitedBy AppUser @relation("InvitedBy", fields: [invitedById], references: [id])

  @@map("staff_invitation_tokens")
  @@index([email])
}

// Security-relevant event log — sign-in, failed sign-in, password reset,
// role change, MFA changes, and session revocation. It also backs login
// attempt rate limiting, including failed logins without a user row.
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String?  // present on failed logins even when no account matches
  type      String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user AppUser? @relation("SecurityEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@map("security_audit_logs")
  @@index([userId, createdAt])
  @@index([email, type, createdAt])
}

// ---------- Booking domain ----------

model BookingRequest {
  id     String @id @default(cuid())
  // Customer-facing reference, e.g. "SB-8K2F1A".
  reference String @unique

  customerId    String  @map("customer_id")
  coordinatorId String? @map("coordinator_id")

  serviceType ServiceType   @map("service_type")
  status      BookingStatus @default(SUBMITTED)

  // Trip details. Not every field applies to every service type.
  tourSlug       String?       @map("tour_slug")
  pickupAddress  String?       @map("pickup_address")
  dropoffAddress String?       @map("dropoff_address")
  vehicleClass   VehicleClass? @map("vehicle_class")
  travelDate     DateTime      @map("travel_date")
  paxCount       Int           @map("pax_count")
  notes          String?

  // Money stored as integer cents. quotedPriceCents is the indicative
  // figure from the public calculator; confirmedPriceCents is set by a
  // coordinator and is the only figure ever presented as final.
  quotedPriceCents    Int?    @map("quoted_price_cents")
  confirmedPriceCents Int?    @map("confirmed_price_cents")
  currency            String  @default("NZD")

  cancelledAt DateTime? @map("cancelled_at")
  // Coordinator-set urgency flag surfaced in the queue view.
  priority    Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer    AppUser  @relation("CustomerBookings", fields: [customerId], references: [id])
  coordinator AppUser? @relation("CoordinatedBookings", fields: [coordinatorId], references: [id])

  assignments BookingAssignment[]
  messages    BookingMessage[]
  events      BookingEvent[]

  @@map("booking_requests")
  @@index([customerId])
  @@index([coordinatorId])
  @@index([status])
  @@index([serviceType])
  @@index([travelDate])
}

model BookingAssignment {
  id               String           @id @default(cuid())
  bookingRequestId String           @map("booking_request_id")
  driverId         String           @map("driver_id")
  offeredById      String           @map("offered_by_id")
  status           AssignmentStatus @default(OFFERED)

  offeredAt    DateTime  @default(now()) @map("offered_at")
  respondedAt  DateTime? @map("responded_at")
  declineReason String?  @map("decline_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  driver         AppUser        @relation("DriverAssignments", fields: [driverId], references: [id])
  offeredBy      AppUser        @relation("OfferedByCoordinator", fields: [offeredById], references: [id])

  @@map("booking_assignments")
  @@index([bookingRequestId, status])
  @@index([driverId])
}

model BookingMessage {
  id               String             @id @default(cuid())
  bookingRequestId String             @map("booking_request_id")
  senderId         String             @map("sender_id")
  visibility       MessageVisibility
  body             String

  createdAt DateTime @default(now()) @map("created_at")

  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  sender         AppUser        @relation(fields: [senderId], references: [id])

  @@map("booking_messages")
  @@index([bookingRequestId, createdAt])
}

model BookingEvent {
  id               String  @id @default(cuid())
  bookingRequestId String  @map("booking_request_id")
  actorId          String? @map("actor_id")

  previousStatus BookingStatus? @map("previous_status")
  newStatus      BookingStatus  @map("new_status")
  // Safe, non-secret context only (e.g. { "declineReason": "..." }).
  context Json?

  createdAt DateTime @default(now()) @map("created_at")

  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  actor          AppUser?       @relation(fields: [actorId], references: [id])

  @@map("booking_events")
  @@index([bookingRequestId, createdAt])
}

// Account-level audit trail (role changes, activate/deactivate) — separate
// from booking_events because those are scoped to a booking_request_id and
// user-account changes aren't tied to any single booking. Added beyond the
// original six tables specifically to satisfy "audit all role and
// active-status changes" for /admin/users.
model AuditLog {
  id             String  @id @default(cuid())
  actorId        String  @map("actor_id")
  targetUserId   String  @map("target_user_id")
  action         String
  previousValue  String? @map("previous_value")
  newValue       String? @map("new_value")
  reason         String?

  createdAt DateTime @default(now()) @map("created_at")

  actor      AppUser @relation("AuditActor", fields: [actorId], references: [id])
  targetUser AppUser @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@map("audit_logs")
  @@index([targetUserId, createdAt])
}

model Notification {
  id     String  @id @default(cuid())
  userId String  @map("user_id")
  type   String
  title  String
  body   String
  link   String?
  read   Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId, read])
}
