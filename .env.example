# Database (Neon Postgres)
# Use the pooled connection string (host ending in "-pooler") for normal
# app traffic — this is what Prisma Client uses at runtime on Vercel.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/southbound?sslmode=require"
# Use the direct (unpooled) connection string here — Prisma needs this to
# run `prisma migrate` against a PgBouncer-fronted database like Neon's.
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/southbound?sslmode=require"

# Resend (booking-request email to the operator)
RESEND_API_KEY=""
EMAIL_FROM="bookings@yourdomain.com"
# Inbox that receives new booking requests. Optional — if unset, requests
# still save to the database and coordinators are still notified in-app;
# only the operator email is skipped.
BOOKING_NOTIFICATION_EMAIL="owner@yourdomain.com"

# Routing/geocoding provider for live transfer quotes
# (placeholder formula is used in src/lib/pricing.ts until this is wired in)
NEXT_PUBLIC_MAPS_API_KEY=""

# Public site URL — backs canonical links, sitemap, and default OG image URLs
NEXT_PUBLIC_SITE_URL="https://southbound.example.com"

# --- PR1: Authentication hardening ---

# Signs the short-lived MFA-pending cookie used between password check and
# TOTP verification. Generate with: openssl rand -base64 32
# REQUIRED before any user can sign in if you enable this in production —
# leave unset in early local dev and it will throw a clear error the first
# time it's needed (MFA challenge), not silently misbehave.
AUTH_SECRET=""

# Encrypts admin TOTP secrets at rest (AES-256-GCM) — must decode to exactly
# 32 bytes. Generate with: openssl rand -base64 32
# Only required once an Admin actually enables two-factor authentication.
MFA_ENCRYPTION_KEY=""

# Optional email delivery. If either is unset, PR1's auth emails
# (verification, password reset, staff invitation) log to the server
# console instead of sending — so the full flow works locally without a
# live Resend account. Set both to send real email.
# RESEND_API_KEY="" (see Resend config above)
# EMAIL_FROM="" (see Resend config above)
